# ===== Docker 数据卷（容器持久化数据，不入仓） =====
server/data/
# Docker 用户上传的 SSL 证书（敏感）
server/docker/nginx/cert/*.pem
server/docker/nginx/cert/*.key
!server/docker/nginx/cert/README.md

# ===== 静默部署运行时数据（用户机器上的） =====
