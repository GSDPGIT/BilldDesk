# BilldDesk Docker 部署环境变量
# 用法：cp .env.example .env，按需修改
# 注意：MYSQL_ROOT_PASSWORD 必须和 secret.ts 里的 MYSQL_CONFIG.password 完全一致

# ===== MySQL =====
MYSQL_ROOT_PASSWORD=billd_desk_root_change_me
MYSQL_DATABASE=billd_desk

# ===== Redis =====
# 默认无密码（与 docker-compose.yml 一致）；如启用 requirepass，填这里并改 compose
# REDIS_PASSWORD=billd_desk_redis_change_me

# ===== Nginx 对外端口 =====
# 国内服务器没备案时改成 8080/8443 绕开运营商封禁
HTTP_PORT=80
HTTPS_PORT=443
